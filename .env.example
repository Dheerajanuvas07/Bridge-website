# Copy to .env.local and fill in. Never commit real values.
# Phase 2 (static pages) needs none of these. They're used from Phase 4.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=          # server only

# Resend
RESEND_API_KEY=               # server only, sending access only
EMAIL_FROM=                   # e.g. Bridge <hello@send.bridgelincoln.com>
EMAIL_REPLY_TO=               # your personal Gmail for now
ADMIN_NOTIFY_EMAIL=           # your personal Gmail; set in .env.local and Netlify only

# Admin access
ADMIN_EMAILS=                 # comma-separated allow-list

# Spam protection: random string used to hash IPs for rate limiting
IP_HASH_SALT=
