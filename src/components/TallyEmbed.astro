---
// Tally form embed. site.ts adds the visitor's source (?src=, utm_*) and loads Tally's script.
interface Props {
  formId: string;
  page: string;     // sent as a hidden field so we know which page the request came from
  title: string;
  height?: number;
}
const { formId, page, title, height = 560 } = Astro.props;
const embed = `https://tally.so/embed/${formId}?alignLeft=1&hideTitle=1&transparentBackground=1&dynamicHeight=1`;
---
<div>
  <iframe
    data-tally-src={embed}
    data-page={page}
    loading="lazy"
    width="100%"
    height={height}
    title={title}
    class="block w-full border-0"
  ></iframe>
  <p class="mt-3 text-base text-ink-2">
    Form not showing? <a href={`https://tally.so/r/${formId}`} data-tally-link data-page={page} target="_blank" rel="noopener">Open it in a new tab</a>.
  </p>
</div>
