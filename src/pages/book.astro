---
import Base from '../layouts/Base.astro';
import TallyEmbed from '../components/TallyEmbed.astro';
import { site } from '../data/site';
---
<Base
  title="Request a visit | Bridge, Lincoln and Omaha"
  description="Tell us about your parent’s appointment. We’ll call you within 24 hours. $149 per visit, and no charge until we’ve talked with you and your parent."
>
  <section class="wrap grid gap-12 py-12 sm:py-16 lg:grid-cols-[1.4fr_1fr] lg:gap-16">
    <div id="request-form">
      <h1 class="text-4xl sm:text-5xl">Request a visit</h1>
      <p class="prose-w mt-4 text-xl text-ink-2">Five short questions. We’ll call you {site.responseTime} to talk through the appointment.</p>
      <p class="mt-3 text-base text-ink-2">Please don’t include medical details. We’ll ask what we need on the phone.</p>
      <div class="mt-8">
        <TallyEmbed formId={site.tally.request} page="request" title="Request a visit form" />
      </div>
    </div>

    <aside class="h-fit rounded-md border border-line bg-white p-6 sm:p-8">
      <h2 class="text-2xl">What happens next</h2>
      <ol class="mt-4 list-decimal space-y-3 pl-6 marker:font-bold marker:text-green">
        <li>We call you {site.responseTime} to hear about the appointment.</li>
        <li>We talk with your parent. If they’d rather not, we don’t go.</li>
        <li>We confirm the time and tell you who the Captain is.</li>
      </ol>
      <p class="mt-6 border-t border-line pt-6"><strong>${site.price.standard} per visit</strong>, up to {site.price.hours} hours. ${site.price.extended} for longer or out-of-town visits. No charge until we’ve talked with you and your parent.</p>
      <p class="mt-6 border-t border-line pt-6">Rather talk now? Call or text <a href={site.phoneHref} data-track-loc="request-page" class="font-bold">{site.phone}</a>.</p>
    </aside>
  </section>
</Base>
